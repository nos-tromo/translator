# INFERENCE_NETWORK=inference-net
# TRANSLATOR_FRONTEND_HOST_PORT=8501
# TRANSLATOR_BACKEND_HOST_PORT=8000
# OPENAI_API_BASE=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# TEXT_MODEL=${TEXT_MODEL}
# DEFAULT_TARGET_LANGUAGE=English          # build-time SPA default; change requires `make build`

# UI language of the SPA (uniform federation var; en|de, default en).
# Does NOT set the translation target — that is chosen per request in the UI.
# RESPONSE_LANGUAGE=de

# Edge secret: the edge gateway sends it in X-Edge-Secret, and once set the
# backend trusts X-Auth-User / X-Auth-Name only on requests carrying it. At
# least 32 characters; generate it with `make secret` in edge-plane — the same
# value goes into edge-plane's .env. Unset keeps trusting the identity headers
# from any caller. Configure the gateway first (docs/configuration.md).
# TRANSLATOR_EDGE_SECRET=

# Proxy bypass: comma-separated extra hostnames appended to NO_PROXY/no_proxy.
# Must start with a leading comma:
# EXTRA_NO_PROXY=,ollama,vllm-router
