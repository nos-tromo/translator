# translator — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)


# =============================================================================
# Required
# =============================================================================

# API key for the inference router. Must equal the router's master key (the
# OPENAI_API_KEY in vllm-service's .env). docker/compose.yaml falls back to
# `dummy`, which suits servers that do not enforce auth.
# [required] [secret] [shared: vllm-service]
OPENAI_API_KEY=

# =============================================================================
# Auth & identity
# =============================================================================

# Edge secret: the edge gateway sends it in X-Edge-Secret, and once set the
# backend trusts X-Auth-User / X-Auth-Name only on requests carrying it. At
# least 32 characters; generate it with `make secret` in edge-plane, which
# needs the same value in its own .env. Unset keeps trusting the identity
# headers from any caller. Configure the gateway first (docs/configuration.md).
# [secret] [shared: edge-plane]
# TRANSLATOR_EDGE_SECRET=

# =============================================================================
# Network & proxy
# =============================================================================

# Name of the external network between the app backends and vllm-service.
# Created via `make network`. Override only if you renamed it.
# INFERENCE_NETWORK=inference-net

# Name of the external network the frontend joins, where the edge-plane
# gateway reaches it as `translator-frontend`. Override only if you renamed it.
# EDGE_NET=edge-net

# Proxy bypass: comma-separated extra hostnames appended to NO_PROXY/no_proxy.
# Must start with a leading comma, for example
#   EXTRA_NO_PROXY=,ollama,vllm-router
# EXTRA_NO_PROXY=

# =============================================================================
# Inference
# =============================================================================

# Base URL of the OpenAI-compatible endpoint, including /v1. The default is
# the router on inference-net; point it elsewhere to change provider, for
# example
#   OPENAI_API_BASE=http://ollama:11434/v1
# OPENAI_API_BASE=http://vllm-router:4000/v1

# Model passed in every chat-completions request, for translation and for
# source-language detection, so it must be instruction-tuned.
# TEXT_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit

# =============================================================================
# translator
# =============================================================================

# UI language of the SPA (uniform federation var; en|de). Does NOT set the
# translation target; that is chosen per request in the UI.
# RESPONSE_LANGUAGE=en

# Default target language of the SPA. Build-time: a change needs `make build`.
# DEFAULT_TARGET_LANGUAGE=English

# =============================================================================
# Audit & retention
# =============================================================================

# Data-protection audit log (docs/audit.md): comma-separated actions that
# need a stated purpose (X-Audit-Purpose header, sent from the SPA's purpose
# bar). Only `ai_call` has an effect in translator: set it to refuse a
# translation without a purpose with 428 (the bar then asks for one). Empty
# turns it off. AUDIT_OUTPUT is set by docker/compose.yaml.
# AUDIT_REQUIRE_PURPOSE=

# =============================================================================
# Development only
# =============================================================================

# Fallback account for requests without a trusted X-Auth-User: /translate
# answers 401 otherwise. The dev overlay (make dev / make up-dev) sets it to
# `dev`; set it here to pick another invented account or for a local run
# without Docker. Ignored while TRANSLATOR_EDGE_SECRET is set. Leave unset in
# production.
# [dev]
# TRANSLATOR_DEFAULT_IDENTITY=dev

# Host ports of the dev overlay (make up-dev).
# [dev]
# TRANSLATOR_FRONTEND_HOST_PORT=8501
# [dev]
# TRANSLATOR_BACKEND_HOST_PORT=8000
